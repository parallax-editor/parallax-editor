{
  "schemaVersion": "1.1",
  "meta": { "title": "Matrix: interactive PNG hover-scale gates on hover (not on load)", "lang": "es" },
  "sections": [
    {
      "id": "ihs-sec", "height": "100vh", "scrollBehavior": "continuous",
      "background": { "type": "color", "value": "#0f1018" },
      "layers": [
        {
          "id": "ihs-layer", "depth": 0,
          "elements": [
            { "id": "ihs-png", "type": "png", "src": "/assets/dot.png", "alt": "imagen interactiva con hover",
              "position": { "x": 50, "y": 50 }, "anchor": "center",
              "size": { "width": "120px", "height": "120px" },
              "interactive": true,
              "animations": [ { "type": "scale", "trigger": "hover", "from": 1, "to": 1.3, "duration": 200, "easing": "easeOut" } ] }
          ]
        }
      ]
    }
  ]
}
