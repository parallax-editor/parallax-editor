{
  "schemaVersion": "1.1",
  "meta": { "title": "Matrix(real): png flor-surreal — link must navigate with 3 concurrent anims, under a higher text layer", "lang": "es" },
  "sections": [
    {
      "id": "rp-sec", "height": "260vh", "scrollBehavior": "continuous", "scrollDirection": "vertical",
      "background": { "type": "gradient", "value": "linear-gradient(180deg, #2a311f 0%, #1c2418 50%, #11160d 100%)" },
      "layers": [
        {
          "id": "rp-layer-flor", "depth": -0.4, "parallaxMode": ["scroll-vertical", "mouse"],
          "elements": [
            {
              "type": "png",
              "id": "flor-surreal",
              "src": "/assets/dot.png",
              "alt": "Flor surreal de petalos imposibles abriendose en la oscuridad",
              "position": { "x": 70, "y": 18 },
              "size": { "width": "min(46%, 520px)" },
              "anchor": "center",
              "opacity": 1,
              "rotation": 0,
              "visible": true,
              "interactive": true,
              "link": { "href": "https://example.com/x", "target": "_blank" },
              "animations": [
                { "type": "scale", "trigger": "scroll", "from": 0.7, "to": 1.15, "range": [0.05, 0.55], "easing": "easeOutCubic" },
                { "type": "rotate", "trigger": "loop", "from": -2, "to": 2, "duration": 11000, "easing": "easeInOut", "loop": true, "yoyo": true },
                { "type": "scale", "trigger": "hover", "from": 0.7, "to": 1, "duration": 4000, "delay": 0, "easing": "linear" }
              ]
            }
          ]
        },
        {
          "id": "rp-layer-concepto", "depth": 0.1, "parallaxMode": ["scroll-vertical"],
          "elements": [
            {
              "type": "text",
              "id": "concepto-encima",
              "position": { "x": 28, "y": 24 },
              "anchor": "center",
              "opacity": 1,
              "rotation": 0,
              "visible": true,
              "interactive": false,
              "animations": [],
              "content": "El concepto",
              "font": "Cormorant Garamond",
              "fontSize": "clamp(1.8rem, 5vw, 3.2rem)",
              "fontWeight": 600,
              "color": "#e9e4d4",
              "textAlign": "left",
              "semanticTag": "h2",
              "splitMode": "none",
              "staggerDelay": 0
            }
          ]
        }
      ]
    }
  ]
}
