{
  "name": "parallax-editor",
  "version": "0.1.9",
  "description": "Local Illustrator-style editor for parallax sites (parallax-engine).",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "electron/main.cjs",
  "scripts": {
    "embed:contract": "node scripts/embed-contract.mjs",
    "preeditor": "node scripts/embed-contract.mjs",
    "editor": "vite --open",
    "predev": "node scripts/embed-contract.mjs",
    "dev": "vite",
    "prebuild": "node scripts/embed-contract.mjs",
    "build": "vite build",
    "prebuild:server": "node scripts/embed-contract.mjs",
    "build:server": "esbuild server/standalone.ts --bundle --platform=node --format=cjs --outfile=dist-server/server.cjs --external:esbuild --external:@aws-sdk/client-s3 --external:chokidar --external:ws --external:fsevents --external:@vue/compiler-sfc",
    "start": "yarn build && yarn build:server && node dist-server/server.cjs",
    "preelectron:dev": "node scripts/embed-contract.mjs",
    "electron:dev": "ELECTRON_DEV=1 electron electron/main.cjs",
    "electron:start": "yarn build && yarn build:server && electron electron/main.cjs",
    "dist:dir": "node scripts/ensure-x64-esbuild.mjs && yarn build && yarn build:server && electron-builder --dir --x64",
    "dist:mac": "node scripts/ensure-x64-esbuild.mjs && yarn build && yarn build:server && electron-builder --mac --x64 --arm64",
    "release": "node scripts/release.mjs",
    "test": "node tests/editor.test.mjs && node tests/git-pathspec.test.mjs && node tests/editor-helpers.test.mjs",
    "test:e2e": "node e2e/harness.cjs --suite=editor",
    "test:e2e:save": "node e2e/suites/save-reflect.cjs",
    "test:e2e:matrix": "node e2e/suites/engine-matrix.cjs",
    "test:e2e:headed": "HEADLESS=0 node e2e/harness.cjs --suite=editor"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@vue/compiler-sfc": "^3.5.38",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-i18n": "^11",
    "vue-router": "^5.1.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@parallax-editor/parallax-engine": "^0.2.4",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "1.61.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.14"
  },
  "homepage": "https://github.com/parallax-editor/parallax-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parallax-editor/parallax-editor.git"
  },
  "bugs": {
    "url": "https://github.com/parallax-editor/parallax-editor/issues"
  },
  "author": "Parallax Editor contributors"
}
